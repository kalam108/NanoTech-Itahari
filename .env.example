# GEMINI_API_KEY / GOOGLE_API_KEY / GOOGLE_CLOUD_API_KEY: Required for Gemini AI API calls.
# AI Studio & Google Cloud automatically inject this at runtime from user secrets.
# Users configure this via the Settings / Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GOOGLE_API_KEY="MY_GOOGLE_CLOUD_API_KEY"
GOOGLE_CLOUD_API_KEY="MY_GOOGLE_CLOUD_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Connected Supabase project URL
SUPABASE_URL="https://zovjbvddiimvxragxxni.supabase.co"
VITE_SUPABASE_URL="https://zovjbvddiimvxragxxni.supabase.co"

# SUPABASE_ANON_KEY: Supabase Public / Publishable Anon Key
SUPABASE_ANON_KEY="sb_publishable_eruSA7SXKOr6YmrDXkZQKA_e77938Pk"
VITE_SUPABASE_ANON_KEY="sb_publishable_eruSA7SXKOr6YmrDXkZQKA_e77938Pk"

# SUPABASE_SERVICE_ROLE_KEY: Supabase Secret / Service Role Key for Backend Admin Operations
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# OPENWEATHER_API_KEY: OpenWeatherMap API key for live store weather in Itahari
OPENWEATHER_API_KEY="your_openweather_api_key_here"
